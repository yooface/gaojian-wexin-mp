{
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "rules", "structureProfiles", "layoutHabits", "mediaHabits", "voiceExamples"],
  "properties": {
    "summary": { "type": "string" },
    "rules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "text"],
        "properties": {
          "label": { "type": "string" },
          "text": { "type": "string" }
        }
      }
    },
    "structureProfiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "fit", "flow", "sectioning"],
        "properties": {
          "name": { "type": "string" },
          "fit": { "type": "string" },
          "flow": { "type": "string" },
          "sectioning": { "type": "string" }
        }
      }
    },
    "layoutHabits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphRhythm", "sectioning", "emphasis"],
      "properties": {
        "paragraphRhythm": { "type": "string" },
        "sectioning": { "type": "string" },
        "emphasis": { "type": "string" }
      }
    },
    "mediaHabits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["images", "memes", "placement"],
      "properties": {
        "images": { "type": "string" },
        "memes": { "type": "string" },
        "placement": { "type": "string" }
      }
    },
    "voiceExamples": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "excerpt", "lesson"],
        "properties": {
          "role": { "type": "string" },
          "excerpt": { "type": "string" },
          "lesson": { "type": "string" }
        }
      }
    }
  }
}
